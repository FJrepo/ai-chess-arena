# Required: your OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Required: choose your own strong database password. The production database
# is internal to Docker and is not exposed to the host.
# Single-quote a password containing $ so Docker Compose treats it literally.
# Existing volumes: follow the password rotation steps in docs/deployment.md;
# changing this value alone does not change a stored database password.
DB_PASSWORD=

# Optional: GHCR namespace; defaults to fjrepo for the official images.
# Set your own GitHub user/org when using images published by a fork.
IMAGE_NAMESPACE=fjrepo

# Release asset docker-compose.yml: leave empty to use that release's pinned tag.
# Repository docker-compose.prod.yml: required; set a tag such as v1.5.0.
# Set explicitly to upgrade; latest is convenience only, not a supported pin.
IMAGE_TAG=

# Optional: frontend host port (default 4200), exposed on loopback only.
# This isolation requires Docker Engine 28.0+; see docs/deployment.md.
# The backend has no host port there; the frontend proxies /api and /ws to it.
FRONTEND_PORT=4200

# Optional: extra host names besides localhost, 127.0.0.1 and [::1]
# (space-separated, no scheme or port; empty by default).
# Requests for any other name get 421, which blocks DNS-rebinding attacks from web pages.
# Only needed if you widen the port binding yourself (unsupported, see docs/deployment.md), e.g.
# ALLOWED_HOSTS="chess-server 192.168.1.20"
ALLOWED_HOSTS=

# Optional: database name (default chess_tournament) and user (default chess).
# Keep these unchanged when reusing an existing database volume.
DB_NAME=chess_tournament
DB_USER=chess
