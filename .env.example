# Released image source for docker-compose.prod.yml
# IMAGE_NAMESPACE: `fjrepo` for the published images, or your own GitHub user/org for a fork.
# IMAGE_TAG is required: set a release version such as v1.1.0 (see GitHub Releases).
# `latest` also works but is a convenience tag; pinned versions give predictable upgrades.
IMAGE_NAMESPACE=your-github-user-or-org
IMAGE_TAG=

# Host port of the frontend, exposed on loopback only by docker-compose.prod.yml.
# This isolation requires Docker Engine 28.0+; see docs/deployment.md.
# The backend has no host port there; the frontend proxies /api and /ws to it.
FRONTEND_PORT=4200

# Host names the UI answers to besides localhost, 127.0.0.1 and [::1] (space-separated, no scheme or port).
# Requests for any other name get 421, which blocks DNS-rebinding attacks from web pages.
# Only needed if you widen the port binding yourself (unsupported, see docs/deployment.md), e.g.
# ALLOWED_HOSTS="chess-server 192.168.1.20"
ALLOWED_HOSTS=

# Runtime secret
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database settings. DB_PASSWORD is required by docker-compose.prod.yml.
# For an existing volume created with the former fallback password, follow the
# one-time password rotation procedure in docs/deployment.md before changing it.
# Single-quote a password containing $ so Docker Compose treats it literally.
DB_NAME=chess_tournament
DB_USER=chess
DB_PASSWORD=
