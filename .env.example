# Optional: leave empty, start the app, then use Connect OpenRouter in System settings.
# Operator-managed alternative: set a key or mount OPENROUTER_API_KEY_FILE read-only.
# These sources override the UI key and cannot be changed through the UI.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FILE=

# Optional for NEW production installs: a private password is generated on first start.
# UPGRADES: keep DB_PASSWORD in an existing .env; do not remove or change it.
# It must still match the password stored in the initialized database volume.
# Explicit DB_PASSWORD wins over the generated file for both db and backend.
# Single-quote a value containing $ so Compose treats it literally.
# DB_PASSWORD=
# Optional: use your own DB secret file instead (container path; mount it read-only
# in both db and backend). Explicit DB_PASSWORD still wins.
# DB_PASSWORD_FILE=/run/secrets/db_password

# Optional: GHCR namespace; defaults to fjrepo for the official images.
# Set your own GitHub user/org when using images published by a fork.
# IMAGE_NAMESPACE=fjrepo

# Release asset docker-compose.yml: leave empty to use that release's pinned tag.
# Repository docker-compose.prod.yml: required; set a tag such as v1.5.0.
# Set explicitly to upgrade; latest is convenience only, not a supported pin.
# IMAGE_TAG=

# Optional: frontend host port (default 4200), exposed on loopback only.
# This isolation requires Docker Engine 28.0+; see docs/deployment.md.
# The backend has no host port there; the frontend proxies /api and /ws to it.
FRONTEND_PORT=4200

# Optional: extra host names besides localhost, 127.0.0.1 and [::1]
# (space-separated, no scheme or port; empty by default).
# Requests for any other name get 421, which blocks DNS-rebinding attacks from web pages.
# When adding LAN hosts, use the one-time setup link printed in the backend log.
# Widening the port binding still needs your own network controls (deployment guide), e.g.
# ALLOWED_HOSTS="chess-server 192.168.1.20"
ALLOWED_HOSTS=
# Optional full browser origin for the printed setup link behind TLS/a reverse proxy.
# Otherwise uses the first concrete allowed LAN host and FRONTEND_PORT (localhost if none).
# APP_ORIGIN=https://chess.example

# Optional: database name (default chess_tournament) and user (default chess).
# Keep these unchanged when reusing an existing database volume.
DB_NAME=chess_tournament
DB_USER=chess
